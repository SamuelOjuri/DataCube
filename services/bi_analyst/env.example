# Independent configuration. Never use the repository ETL/service-role DSN.
BI_ANALYST_ENVIRONMENT=production
BI_ANALYST_READ_DSN=host=YOUR_DIRECT_OR_SESSION_HOST port=5432 dbname=postgres user=bi_analyst_reader password=REPLACE sslmode=verify-full
BI_ANALYST_STATE_DSN=host=YOUR_DIRECT_OR_SESSION_HOST port=5432 dbname=postgres user=bi_analyst_state password=REPLACE sslmode=verify-full
BI_ANALYST_CORS_ORIGINS=https://YOUR_PRODUCTION_FRONTEND
BI_ANALYST_READ_POOL_SIZE=2
BI_ANALYST_STATE_POOL_SIZE=2
BI_ANALYST_REPLICA_COUNT=1
# This must be the allocation reserved for the analyst, after ETL/other services.
BI_ANALYST_CONNECTION_BUDGET=4
BI_ANALYST_POOL_TIMEOUT_SECONDS=3
BI_ANALYST_STATEMENT_TIMEOUT_MS=5000
BI_ANALYST_REQUESTS_PER_MINUTE=60
BI_ANALYST_MAX_BODY_BYTES=32768
# Keep disabled until migration 005 and the dedicated Monday OAuth app are configured.
BI_ANALYST_AUTH_PROVIDER=disabled
BI_ANALYST_MONDAY_CLIENT_ID=REPLACE
BI_ANALYST_MONDAY_CLIENT_SECRET=REPLACE
BI_ANALYST_MONDAY_ACCOUNT_ID=123456
BI_ANALYST_MONDAY_REDIRECT_URI=https://YOUR_ANALYST_API.onrender.com/auth/callback
BI_ANALYST_AUTH_FRONTEND_URL=https://YOUR_PRODUCTION_FRONTEND/auth/callback
# Absolute lifetime; reauthenticate with Monday afterwards. Maximum 900 seconds.
BI_ANALYST_SESSION_SECONDS=900
# Shared service-wide pre-authentication budget, across all instances.
BI_ANALYST_AUTH_REQUESTS_PER_MINUTE=120

# Approved business timezone; runtime defaults to this owner decision.
BI_ANALYST_BUSINESS_TIMEZONE=Europe/London
BI_ANALYST_METRIC_MAX_ROWS=1000
BI_ANALYST_METRIC_MAX_BYTES=900000
BI_ANALYST_METRIC_CONCURRENCY=2
BI_ANALYST_METRIC_TIMEOUT_SECONDS=15
# Uncertified evaluation is allowed only for environment=test on a loopback DB.
# This cannot enable metrics on staging/production or certify the catalogue.
BI_ANALYST_METRIC_EVALUATION_ENABLED=false

# Optional live source evidence. Dedicated server credential with boards:read and
# me:read, limited to the approved app account/boards. Never use sign-in tokens.
# Source checks become available when this token and MONDAY_ACCOUNT_ID are set.
# BI_ANALYST_MONDAY_READ_TOKEN=
BI_ANALYST_MONDAY_READ_API_VERSION=2026-07
BI_ANALYST_MONDAY_READ_TIMEOUT_SECONDS=10
BI_ANALYST_MONDAY_READ_MAX_BYTES=262144
BI_ANALYST_MONDAY_READ_CONCURRENCY=2

# Phase 5: enable after migration 006 and reviewing the model evaluation report.
BI_ANALYST_WORKFLOW_ENABLED=false
# Independent analyst key; never copied into frontend configuration.
# BI_ANALYST_GEMINI_API_KEY=
BI_ANALYST_WORKFLOW_CONCURRENCY=2
BI_ANALYST_WORKFLOW_TIMEOUT_SECONDS=90
BI_ANALYST_WORKFLOW_MAX_MODEL_CALLS=8
BI_ANALYST_MODEL_TIMEOUT_SECONDS=25
# Model and generation settings are pinned in workflow/provider.py.
